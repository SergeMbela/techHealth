import xlsxwriter

# 1. Créer un writer Excel
output_file = "rapport_grippe_2024.xlsx"
with pd.ExcelWriter(output_file, engine="xlsxwriter") as writer:
    
    # 2. Onglet : Détail des prises de sang
    df.to_excel(writer, sheet_name="Données", index=False)
    
    # 3. Onglet : Statistiques globales
    stats_df = pd.DataFrame({
        "Statistique": [
            "Nombre total de patients",
            "Nombre total de tests",
            "Nombre total de cas positifs",
            "Taux global de positivité"
        ],
        "Valeur": [
            total_patients,
            total_tests,
            total_positifs,
            f"{taux_global:.2%}"
        ]
    })
    stats_df.to_excel(writer, sheet_name="Statistiques", index=False)

    # 4. Onglet : Taux par vaccination
    positif_par_vaccin.reset_index().to_excel(writer, sheet_name="Taux par vaccination", index=False)

    # 5. Ajouter un graphique dans Excel
    workbook = writer.book
    worksheet = writer.sheets["Taux par vaccination"]

    chart = workbook.add_chart({'type': 'column'})
    chart.add_series({
        'name': 'Taux de positivité',
        'categories': ['Taux par vaccination', 1, 0, 2, 0],  # lignes 2-3, col A
        'values':     ['Taux par vaccination', 1, 3, 2, 3],  # lignes 2-3, col D
        'fill': {'color': '#4CAF50'},
    })

    chart.set_title({'name': 'Grippe - Taux Vaccinés vs Non Vaccinés'})
    chart.set_y_axis({'major_gridlines': {'visible': False}})
    chart.set_x_axis({'name': 'Statut Vaccinal'})
    chart.set_y_axis({'name': 'Taux de positivité'})

    worksheet.insert_chart('F2', chart)

print(f"✅ Rapport Excel généré : {output_file}")
